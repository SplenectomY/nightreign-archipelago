profileVersion = "v1"

[[supports]]
game = "nightreign"

# Seamless MUST load before our DLL. SignIn is patched in nrsc DllMain.
# Do not launch with nrsc_launcher.exe and this profile at the same time.
# Paths must use forward slashes. Backslashes are escape characters and the file will not load.

[[natives]]
path = 'C:/Program Files (x86)/Steam/steamapps/common/ELDEN RING NIGHTREIGN/Game/SeamlessCoop/nrsc.dll'
optional = false
load_early = true

[[natives]]
path = 'C:/Mods/nightreign-ap/nightreign_ap.dll'
optional = false
load_early = false

# Regulation override. Gates expeditions and default Nightfarers.
# Removing this block stops the expedition-board exit. Paths use forward slashes.
[[packages]]
id = "nrap-regulation"
path = 'C:/Mods/nightreign-ap/regulation'
